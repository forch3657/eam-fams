# 复制为 .env 后修改

# 数据模式：true = 内置 mock，false = 后端接口
# 注意：留空时按 mock 处理（默认 true）；只有同时满足「false + 下面地址非空」才走后端
VITE_USE_MOCK=false

# 后端接口根地址，例如 http://localhost:8080/api
# 留空或 VITE_USE_MOCK=true 时不会发起任何网络请求
VITE_API_BASE_URL=http://localhost:8080/api

# ---- 以下仅 mock 模式生效 ----
# 模拟网络延迟（毫秒），用于演练 loading 分支
VITE_MOCK_LATENCY=0

# 随机故障概率（0~1），用于演练错误提示分支
VITE_MOCK_ERROR_RATE=0
