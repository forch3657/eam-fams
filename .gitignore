# 本地密钥（生产 JWT_SECRET 等，绝不入库）
deploy/.secrets/

# 内网 HTTPS 自签证书私钥与工具缓存（CA 根证书 fams-ca.crt 需分发，私钥绝不入库）
deploy/certs/*.key
scripts/.cert-tools/

# 构建产物
fams-backend/target/
fams-frontend/node_modules/
fams-frontend/dist/

# E2E 测试产物
node_modules/
playwright-report/
test-results/
tests/e2e/.auth/
e2e-artifacts/

# 运行时日志（nginx 的 access/error/pid 不入库）
deploy/nginx/logs/

# 日志与临时脚本
*.log
*.log.gz
*.err
scripts/tmp-*.ps1

# 第三方安装包 / 本地工具二进制（体积大且非源码）
*.exe
liuxun/

# 发布脚本的本地缓存（内网仓 clone，不入库）
.publish-cache/
